{
  "name": "cortad",
  "version": "1.0.0",
  "description": "Like CodeRabbit, but for AI behavior. Runs a simulation against your AI app and says what your change did.",
  "type": "module",
  "bin": {
    "cortad": "bin/cortad.mjs"
  },
  "files": [
    "bin",
    "lib",
    "skill",
    "docs/simulations.md",
    "cortad.schema.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0",
  "homepage": "https://cortad.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cortad/cortad.git"
  },
  "keywords": [
    "llm",
    "evals",
    "agents",
    "testing",
    "red-team",
    "simulation"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/cortad/cortad/issues"
  },
  "author": "Cortad",
  "exports": {
    ".": "./lib/index.mjs",
    "./trace": "./lib/trace/record.mjs",
    "./package.json": "./package.json"
  }
}
